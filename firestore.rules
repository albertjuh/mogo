
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSupervisor() {
      return isSignedIn() && exists(/databases/$(database)/documents/supervisors/$(request.auth.uid));
    }

    function isRecruiter() {
      return isSignedIn() && exists(/databases/$(database)/documents/recruiters/$(request.auth.uid));
    }

    // --- Collection Rules ---

    match /riders/{riderId} {
      // Riders see their own profile. Admins/Supervisors/Recruiters manage or view all.
      allow read: if isOwner(riderId) || isAdmin() || isSupervisor() || isRecruiter();
      allow write: if isAdmin() || isRecruiter();
    }

    match /payments/{paymentId} {
      // Riders see THEIR OWN. Admins/Supervisors see all.
      allow read: if isAdmin() || isSupervisor() || (isSignedIn() && resource.data.riderId == request.auth.uid);
      
      // Riders can create a payment record (e.g., initiating an STK push).
      allow create: if isSignedIn() && request.resource.data.riderId == request.auth.uid;
      
      // Only Admins (or secure server-side logic) can update or delete.
      allow update, delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via Admin SDK or manually in console
    }

    match /supervisors/{supervisorId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /recruiters/{recruiterId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
