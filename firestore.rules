
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Direct check for the system administrator email
    function isSystemAdmin() {
      return isSignedIn() && request.auth.token.email == 'berto.admin@bodaempire.com';
    }
    
    function isAdmin() {
      return isSystemAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isSupervisor() {
      return isSignedIn() && exists(/databases/$(database)/documents/supervisors/$(request.auth.uid));
    }

    function isRecruiter() {
      return isSignedIn() && exists(/databases/$(database)/documents/recruiters/$(request.auth.uid));
    }

    function isManager() {
      return isAdmin() || isSupervisor() || isRecruiter();
    }

    // --- Collection Rules ---

    match /riders/{riderId} {
      // Riders see their own profile. Managers/Admins see all for fleet management.
      allow read, list: if isOwner(riderId) || isManager();
      // Allow creation during onboarding by authorized staff or self-registration
      allow create: if isOwner(riderId) || isManager();
      allow update: if isManager() || isOwner(riderId);
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      // 1. Allow Riders to read only their own payments
      // 2. Allow Managers/Admins to read and list ALL payments for audit
      allow read, list: if isManager() || (isSignedIn() && (resource == null || resource.data.riderId == request.auth.uid));
      
      // 3. Riders can create a payment record for themselves
      allow create: if isSignedIn() && request.resource.data.riderId == request.auth.uid;
      
      // 4. Only Admin/Managers can update status (e.g., verifying a pending Selcom transaction)
      allow update: if isManager();
      allow delete: if isAdmin();
    }

    // Role-specific registries must be readable by the AuthProvider to determine roles
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow create: if isOwner(adminId) || isSystemAdmin();
      allow update, delete: if isAdmin();
    }

    match /supervisors/{supervisorId} {
      allow read: if isSignedIn();
      allow create: if isOwner(supervisorId) || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /recruiters/{recruiterId} {
      allow read: if isSignedIn();
      allow create: if isOwner(recruiterId) || isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
