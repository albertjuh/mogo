rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isSupervisor() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_supervisor/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isSupervisor();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
    }

    match /riders/{riderId} {
      allow get: if isOwner(riderId) || isAdmin() || isSupervisor();
      allow list: if isAdmin() || isSupervisor();
      // Allow a user to create their own rider profile, or an admin to create one.
      allow create: if isOwner(riderId) || isAdmin();
      allow update: if (isOwner(riderId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /bodas/{bodaId} {
      allow read: if isSignedIn(); // Any signed-in user can see bike details
      allow list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /payments/{paymentId} {
      // Rider can read their own payments, Admin/Supervisor can read all
      allow get: if isAdmin() || isSupervisor() || (isSignedIn() && resource.data.riderId == request.auth.uid);
      allow list: if isAdmin() || isSupervisor();
       // Rider can create their own payment, or Admin can create on their behalf
      allow create: if (isSignedIn() && request.resource.data.riderId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }
    
    match /roles_admin/{userId} {
      allow read, write: if isAdmin();
    }

    match /roles_supervisor/{userId} {
      allow read, write: if isAdmin();
    }
  }
}
