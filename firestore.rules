
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // --- Collection Rules ---

    match /riders/{riderId} {
      // Riders see their own profile. Admins manage all.
      allow read: if isOwner(riderId) || isAdmin();
      allow write: if isAdmin();
    }

    match /payments/{paymentId} {
      // Riders only see payments where they are the owner.
      // Admins see all for financial reporting.
      allow read: if isAdmin() || (isSignedIn() && resource.data.riderId == request.auth.uid);
      
      // Only Admins or verified system processes (simulated) can record payments.
      // If a rider makes a payment via the app, they 'create' it with their uid.
      allow create: if isSignedIn() && request.resource.data.riderId == request.auth.uid;
      
      // Payments are immutable records for audit trails.
      allow update, delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
    }
  }
}
