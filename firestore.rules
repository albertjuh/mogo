rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Administrative Override: Identify the system administrator by email
    function isSystemAdmin() {
      return isSignedIn() && request.auth.token.email == 'berto.admin@bodaempire.com';
    }
    
    function isAdmin() {
      return isSystemAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isSupervisor() {
      return isSignedIn() && exists(/databases/$(database)/documents/supervisors/$(request.auth.uid));
    }

    function isRecruiter() {
      return isSignedIn() && exists(/databases/$(database)/documents/recruiters/$(request.auth.uid));
    }

    function isManager() {
      return isAdmin() || isSupervisor() || isRecruiter();
    }

    // --- Collection Rules ---

    match /riders/{riderId} {
      // 1. Allow the System Admin and Managers to list and read ALL riders
      // 2. Allow Riders to read/update their own profile
      allow read, list: if isSystemAdmin() || isManager() || isOwner(riderId);
      
      // 3. Allow creation during onboarding by authorized staff or self-registration
      allow create: if isSystemAdmin() || isManager() || isOwner(riderId);
      
      // 4. Managers or Owners can update details
      allow update: if isSystemAdmin() || isManager() || isOwner(riderId);
      
      // 5. Only Admin can delete
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      // 1. Allow the System Admin and Managers to read/list ALL payments
      // 2. Allow Riders to read/list only THEIR OWN payments
      allow read, list: if isSystemAdmin() || isManager() || (isSignedIn() && (resource == null || resource.data.riderId == request.auth.uid));
      
      // 3. Riders can create a payment record for themselves
      allow create: if isSignedIn() && (isSystemAdmin() || isManager() || request.resource.data.riderId == request.auth.uid);
      
      // 4. Only Admin/Managers can update status (e.g., verifying a Selcom transaction)
      allow update: if isManager();
      
      // 5. Only Admin can delete
      allow delete: if isAdmin();
    }

    // Role-specific registries
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow create: if isOwner(adminId) || isSystemAdmin();
      allow update, delete: if isAdmin();
    }

    match /supervisors/{supervisorId} {
      allow read: if isSignedIn();
      allow create: if isOwner(supervisorId) || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /recruiters/{recruiterId} {
      allow read: if isSignedIn();
      allow create: if isOwner(recruiterId) || isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}