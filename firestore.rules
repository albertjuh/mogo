rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Core Authorization Helpers ---
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // PRIMARY OVERRIDE: Your absolute authority
    // Using .lower() to prevent case-sensitivity lockouts
    function isSystemAdmin() {
      return isSignedIn() && 
             request.auth.token.email.lower() == 'berto.admin@bodaempire.com';
    }
    
    // REGISTRY CHECK: Check if UID exists in the admins collection
    function isAdmin() {
      return isSystemAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isSupervisor() {
      return isSignedIn() && exists(/databases/$(database)/documents/supervisors/$(request.auth.uid));
    }

    function isRecruiter() {
      return isSignedIn() && exists(/databases/$(database)/documents/recruiters/$(request.auth.uid));
    }

    function isManager() {
      return isAdmin() || isSupervisor() || isRecruiter();
    }

    // --- Global Administrative Access ---
    // This allows you (System Admin) to bypass all specific collection rules
    match /{document=**} {
      allow read, write: if isSystemAdmin();
    }

    // --- Collection Specific Rules (for non-System Admins) ---

    match /riders/{riderId} {
      // Riders see themselves; Managers see everyone
      allow read, list: if isManager() || isOwner(riderId);
      
      // Onboarding can be done by managers or self-reg
      allow create: if isManager() || isOwner(riderId);
      
      // Updates allowed for managers or owners
      allow update: if isManager() || isOwner(riderId);
      
      // Only full Admins can delete rider profiles
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      // Ledger visibility: Managers see all; Riders see own
      allow read, list: if isManager() || (isSignedIn() && (resource == null || resource.data.riderId == request.auth.uid));
      
      // Payment creation
      allow create: if isSignedIn() && (isManager() || request.resource.data.riderId == request.auth.uid);
      
      // Status verification (e.g. Selcom webhook flow)
      allow update: if isManager();
      
      // Deletion restricted to Admins
      allow delete: if isAdmin();
    }

    // Role-specific registries
    // These rules allow a user to create their own role profile immediately after signup
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow create: if isOwner(adminId) || isSystemAdmin();
      allow update, delete: if isAdmin();
    }

    match /supervisors/{supervisorId} {
      allow read: if isSignedIn();
      allow create: if isOwner(supervisorId) || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /recruiters/{recruiterId} {
      allow read: if isSignedIn();
      allow create: if isOwner(recruiterId) || isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}