rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CORE PHILOSOPHY
     * This ruleset implements a robust Role-Based Access Control (RBAC) and Owner-Based model for a
     * Fintech fleet management system. Security is prioritized at the foundation to ensure financial
     * integrity and PCI-DSS compliance by design.
     *
     * DATA STRUCTURE
     * - /adminUsers: A registry of UIDs that grants administrative privileges across the system.
     * - /riders: Fleet member details, strictly managed by administrators.
     * - /payments: Financial transactions linked to riders via denormalized 'riderId' fields.
     * - /fleetGoals: Strategic growth planning data, restricted to administrators.
     *
     * KEY SECURITY DECISIONS
     * - Authorization Independence: Rules avoid costly get() calls by relying on denormalized
     *   ownership IDs (riderId) within transaction documents.
     * - Admin Dominance: A dedicated /adminUsers collection serves as the source of truth for
     *   system-wide management permissions.
     * - Fintech Integrity: Critical relational fields like 'riderId' in payments are enforced
     *   during creation and made immutable during updates to prevent financial record tampering.
     * - Prototyping Flexibility: While authorization is strictly enforced, specific data shapes
     *   (fields like names, notes, or status types) are not validated to allow for rapid iteration.
     */

    // --- HELPER FUNCTIONS ---

    /** @description Checks if the request is from an authenticated user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the authenticated user is registered as an administrator. */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }

    /** @description Checks if the user's UID matches the provided ID. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** @description Checks if the authenticated user owns the specific document via a denormalized riderId. */
    function isPaymentOwner(resourceData) {
      return isSignedIn() && resourceData.riderId == request.auth.uid;
    }

    // --- COLLECTION RULES ---

    /**
     * @description Access control for administrative users. Registry existence grants global privileges.
     * @path /adminUsers/{adminId}
     * @allow (get) If the user is an admin or is requesting their own admin status.
     * @deny (list) If the user is not an admin.
     * @principle Global Role-Based Access Control (DBAC).
     */
    match /adminUsers/{adminId} {
      allow get: if isAdmin() || isOwner(adminId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Manages motorcycle rider profiles and contract terms.
     * @path /riders/{riderId}
     * @allow (read/write) Only if the user is an authenticated administrator.
     * @deny (all) For non-admin users, including riders themselves (riders managed by admin).
     * @principle Strict administrative segregation for fleet management.
     */
    match /riders/{riderId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isAdmin() && resource != null;
    }

    /**
     * @description Financial transaction records for payments made via Selcom gateway.
     * @path /payments/{paymentId}
     * @allow (get/list) If user is an admin OR the payment's riderId matches the user's UID.
     * @allow (create) If user is an admin OR is creating a payment for themselves (matching riderId).
     * @deny (update/delete) If user is not an admin and attempts to modify another's records.
     * @principle Authorization Independence via denormalized ownership fields.
     */
    match /payments/{paymentId} {
      allow get: if isAdmin() || isPaymentOwner(resource.data);
      
      // Enforce client-side filtering by riderId for non-admin users
      allow list: if isAdmin() || (isSignedIn() && request.query.where.riderId == request.auth.uid);

      allow create: if isAdmin() || (
        isSignedIn() && 
        request.resource.data.riderId == request.auth.uid
      );

      allow update: if (isAdmin() || isPaymentOwner(resource.data)) && 
        resource != null &&
        request.resource.data.riderId == resource.data.riderId; // Enforce immutability of owner

      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Fleet growth goals and strategic calculations.
     * @path /fleetGoals/{goalId}
     * @allow (all) Only for authenticated administrators.
     * @deny (read/write) For any user not in the adminUsers collection.
     * @principle Private administrative data protection.
     */
    match /fleetGoals/{goalId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isAdmin() && resource != null;
    }

  }
}

/**
 * PROTOTYPING MODE NOTICE:
 * These rules enforce strict authorization (WHO can access) but allow flexible data structures
 * (WHAT data is stored). Relational integrity is enforced for ID fields to prevent unauthorized
 * data injection, but general business logic validation should be added as the schema stabilizes.
 */