rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Core Authorization Helpers ---
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // PRIMARY OVERRIDE: Absolute authority for the Strategic Admin accounts
    function isSystemAdmin() {
      return isSignedIn() && (
             request.auth.token.email.lower() == 'berto.admin@bodaempire.com' ||
             request.auth.token.email.lower() == 'aljohme@gmail.com'
      );
    }
    
    // REGISTRY CHECKS: Verify role by checking collection existence
    function isAdmin() {
      return isSystemAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isSupervisor() {
      return isSignedIn() && exists(/databases/$(database)/documents/supervisors/$(request.auth.uid));
    }

    function isRecruiter() {
      return isSignedIn() && exists(/databases/$(database)/documents/recruiters/$(request.auth.uid));
    }

    function isManager() {
      return isAdmin() || isSupervisor() || isRecruiter();
    }

    // --- Global Administrative Access ---
    // GOD MODE: System Admins bypass every restriction for all collections
    match /{document=**} {
      allow read, write: if isSystemAdmin();
    }

    // --- Collection Specific Rules ---

    match /riders/{riderId} {
      // Users see themselves; Managers see the fleet
      allow read, list: if isManager() || isOwner(riderId);
      
      // Allow self-registration profile creation and management updates
      allow create: if isOwner(riderId) || isManager();
      allow update: if isManager() || isOwner(riderId);
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      // Riders see their own payments (requires query filter); Managers see audit trail
      allow read, list: if isManager() || (isSignedIn() && (resource == null || resource.data.riderId == request.auth.uid));
      
      // Payment recording
      allow create: if isSignedIn() && (isManager() || request.resource.data.riderId == request.auth.uid);
      
      // Status verification
      allow update: if isManager();
      allow delete: if isAdmin();
    }

    // Role Registries - Allow users to create their own document during initial signup
    match /admins/{id} {
      allow read: if isSignedIn();
      allow create: if isOwner(id) || isSystemAdmin();
      allow update, delete: if isAdmin();
    }

    match /supervisors/{id} {
      allow read: if isSignedIn();
      allow create: if isOwner(id) || isSystemAdmin();
      allow update, delete: if isAdmin();
    }

    match /recruiters/{id} {
      allow read: if isSignedIn();
      allow create: if isOwner(id) || isSystemAdmin();
      allow update, delete: if isAdmin();
    }
  }
}