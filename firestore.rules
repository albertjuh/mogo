/**
 * BodaEmpire Fleet Management Security Rules
 *
 * Core Philosophy:
 * This ruleset implements a centralized administrative management model. Authorization 
 * is primarily driven by administrative roles, while individual riders are granted 
 * secure access to their own professional records (contracts, payments, and alerts) 
 * via denormalized ownership fields.
 *
 * Data Structure:
 * The system utilizes a flattened, top-level collection structure (/riders, /contracts, 
 * /payments, /alerts, /fleetGoals). This organization supports high-scale reporting 
 * and administrative oversight while maintaining clear security boundaries.
 *
 * Key Security Decisions:
 * - Authorization Independence: Critical fields like 'riderId' are denormalized onto 
 *   contracts, payments, and alerts. This allows the rules to verify access 
 *   without performing expensive cross-document lookups (get() calls).
 * - Administrative Override: A dedicated '/admins' collection identifies users with 
 *   full system access. The existence of a document at /admins/{uid} grants global CRUD.
 * - Rider Self-Service: Riders can view their own profile and associated financial/contract 
 *   data, but cannot modify these records, ensuring data integrity for the fleet owner.
 * - Prototyping Flexibility: While authorization is strictly enforced based on identity 
 *   and relationships, the specific data types and non-relational fields are not 
 *   validated to allow for rapid schema iteration.
 *
 * Denormalization for Authorization:
 * To ensure performant and reliable security checks, the 'riderId' is required on all 
 * documents that belong to a specific rider. This allows for direct validation:
 * 'resource.data.riderId == request.auth.uid'.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    /** @description Checks if the user is authenticated. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the user exists in the admins collection. */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    /** @description Checks if the authenticated user's ID matches the provided ID. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** @description Checks if the authenticated user is the rider associated with the document. */
    function isDocumentRider(data) {
      return isSignedIn() && data.riderId == request.auth.uid;
    }

    /** @description Verifies ownership and document existence for updates/deletes. */
    function isAdminExisting() {
      return isAdmin() && resource != null;
    }

    // --- COLLECTION RULES ---

    /**
     * @description Administrative collection. Existence of a UID here grants full system access.
     * @path /admins/{adminId}
     * @allow (get) Any signed-in user can check if an ID is an admin.
     * @deny (write) No one can write to this collection via client SDKs (managed via Console/Admin SDK).
     * @principle Role-based access control root.
     */
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update, delete: if false; 
    }

    /**
     * @description Stores primary information for each motorcycle rider.
     * @path /riders/{riderId}
     * @allow (create) A user can create their own rider profile.
     * @deny (update) Only admins can update rider status or details.
     * @principle Enforces path-based ownership for riders and admin oversight.
     */
    match /riders/{riderId} {
      allow get: if isAdmin() || isOwner(riderId);
      allow list: if isAdmin();
      allow create: if isOwner(riderId) && request.resource.data.id == riderId;
      allow update: if isAdminExisting() && request.resource.data.id == resource.data.id;
      allow delete: if isAdminExisting();
    }

    /**
     * @description Details of contracts between BodaEmpire and riders.
     * @path /contracts/{contractId}
     * @allow (get) The specific rider or an admin can view the contract.
     * @deny (write) Riders cannot create or modify contracts.
     * @principle Authorization independence using denormalized 'riderId'.
     */
    match /contracts/{contractId} {
      allow get: if isAdmin() || isDocumentRider(resource.data);
      allow list: if isAdmin() || (isSignedIn() && request.query.limit <= 100); // Note: Secure listing requires riderId filter
      allow create: if isAdmin() && request.resource.data.id == contractId;
      allow update: if isAdminExisting() && request.resource.data.id == resource.data.id;
      allow delete: if isAdminExisting();
    }

    /**
     * @description Records payment transactions made by riders.
     * @path /payments/{paymentId}
     * @allow (get) The paying rider or an admin can view the receipt.
     * @deny (delete) Payments are permanent records and cannot be deleted.
     * @principle Relational integrity and audit trail protection.
     */
    match /payments/{paymentId} {
      allow get: if isAdmin() || isDocumentRider(resource.data);
      allow list: if isAdmin() || (isSignedIn() && request.query.limit <= 100);
      allow create: if isAdmin() && request.resource.data.id == paymentId;
      allow update: if isAdminExisting() && request.resource.data.id == resource.data.id;
      allow delete: if false;
    }

    /**
     * @description System-generated alerts for missed payments or expirations.
     * @path /alerts/{alertId}
     * @allow (update) Admins can resolve alerts (mark isResolved = true).
     * @deny (create) Only the system/admin can generate alerts.
     * @principle Restricts alert lifecycle management to administrative roles.
     */
    match /alerts/{alertId} {
      allow get: if isAdmin() || isDocumentRider(resource.data);
      allow list: if isAdmin() || (isSignedIn() && request.query.limit <= 100);
      allow create: if isAdmin() && request.resource.data.id == alertId;
      allow update: if isAdminExisting() && request.resource.data.id == resource.data.id;
      allow delete: if isAdminExisting();
    }

    /**
     * @description Strategic goals for BodaEmpire's fleet expansion.
     * @path /fleetGoals/{fleetGoalId}
     * @allow (read) Any authenticated admin can view goals.
     * @deny (read) Non-admin riders cannot see fleet expansion targets.
     * @principle Internal administrative data protection.
     */
    match /fleetGoals/{fleetGoalId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() && request.resource.data.id == fleetGoalId;
      allow update: if isAdminExisting() && request.resource.data.id == resource.data.id;
      allow delete: if isAdminExisting();
    }
  }
}