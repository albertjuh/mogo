{
  "entities": {
    "Rider": {
      "title": "Rider",
      "description": "Verified motorcycle driver profile linked to Auth identity.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "plateNumber": { "type": "string" },
        "vehicleType": { "enum": ["Boda Boda", "Bajaji"] },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "active"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Financial ledger record for lease installments.",
      "type": "object",
      "properties": {
        "riderId": { "type": "string" },
        "amount": { "type": "number" },
        "gatewayRef": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "verified", "failed"] },
        "recordedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["riderId", "amount", "status", "recordedAt"]
    },
    "Staff": {
      "title": "Staff Member",
      "description": "Management account with operational privileges.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "supervisor", "recruiter"] }
      }
    }
  },
  "auth": {
    "providers": ["password", "google"]
  },
  "firestore": {
    "/riders/{riderId}": {
      "schema": { "$ref": "#/backend/entities/Rider" },
      "description": "Profiles for boda drivers."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/backend/entities/Payment" },
      "description": "Financial records for the fleet."
    },
    "/admins/{id}": { "schema": { "$ref": "#/backend/entities/Staff" }, "description": "Registry for strategic owners." },
    "/supervisors/{id}": { "schema": { "$ref": "#/backend/entities/Staff" }, "description": "Registry for ground operations." },
    "/recruiters/{id}": { "schema": { "$ref": "#/backend/entities/Staff" }, "description": "Registry for onboarding team." }
  }
}