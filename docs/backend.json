
{
  "entities": {
    "Rider": {
      "title": "Rider",
      "description": "Authenticated motorcycle rider with profile and contract data.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "plateNumber": { "type": "string" },
        "vehicleType": { "enum": ["Boda Boda", "Bajaji"] },
        "dailyFee": { "type": "number" },
        "paymentFrequency": { "enum": ["Daily", "Weekly", "10-Day"] },
        "contractStart": { "type": "string", "format": "date-time" },
        "contractEnd": { "type": "string", "format": "date-time" },
        "active": { "type": "boolean" },
        "guarantorName": { "type": "string" },
        "guarantorPhone": { "type": "string" }
      },
      "required": ["name", "phone", "plateNumber", "active"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Financial transaction record with Selcom reference and JWT-based rider tracking.",
      "type": "object",
      "properties": {
        "riderId": { "type": "string", "description": "The UID of the rider from Firebase Auth." },
        "amount": { "type": "number" },
        "selcomRef": { "type": "string", "description": "External bank reference number." },
        "status": { "type": "string", "enum": ["pending", "verified", "failed"] },
        "recordedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["riderId", "amount", "status", "recordedAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Internal staff with elevated privileges.",
      "type": "object",
      "properties": {
        "email": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/riders/{riderId}": {
      "schema": { "$ref": "#/backend/entities/Rider" },
      "description": "Rider profiles. Owners can only access their own data via JWT uid verification."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/backend/entities/Payment" },
      "description": "Financial ledger. Riders see their own payments; Admins see all for audit."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/backend/entities/Admin" },
      "description": "Registry for users with management access."
    }
  }
}
