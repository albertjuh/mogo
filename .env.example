# Copy this file to .env.local for local development.
# In production (Vercel), set these as project environment variables instead
# of committing them anywhere.

# --- Genkit / Google AI (Growth Planner, Report Insights) ---
GEMINI_API_KEY=

# --- Snippe (mobile money payments) ---
# Dashboard > Settings > API Keys. Needs collection:read + collection:create scopes.
SNIPPE_API_KEY=snp_...
# Dashboard > Settings > Webhook Secret. Used to verify the /api/webhooks/snippe callback.
SNIPPE_WEBHOOK_SECRET=
# Public URL of the deployed webhook endpoint, e.g. https://mogo-lovat.vercel.app/api/webhooks/snippe
SNIPPE_WEBHOOK_URL=

# --- Firebase Admin SDK (server-side only, used by payment actions + webhook) ---
# Firebase Console > Project Settings > Service Accounts > Generate new private key.
# Paste the full JSON as a single-line string.
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'
