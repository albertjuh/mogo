# Copy this file to .env.local for local development.
# In production (Vercel), set these as project environment variables instead
# of committing them anywhere.

# --- Genkit / Google AI (Growth Planner, Report Insights) ---
GEMINI_API_KEY=

# --- AzamPay (mobile money: M-Pesa, Mixx by Yas, Airtel Money, HaloPesa, AzamPesa) ---
# "sandbox" (default) or "live".
AZAMPAY_ENV=sandbox
# AzamPay merchant portal > your app: App Name, Client ID and Client Secret.
AZAMPAY_APP_NAME=
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
# AzamPay merchant portal > Settings: the API key / token (sent as X-API-Key).
AZAMPAY_API_KEY=
# Any long random string. Register this callback URL in the AzamPay portal:
#   https://<your-domain>/api/webhooks/azampay?secret=<AZAMPAY_CALLBACK_SECRET>
AZAMPAY_CALLBACK_SECRET=
# Payouts (admin withdrawals): the business's own disbursement source account.
AZAMPAY_SOURCE_ACCOUNT=
AZAMPAY_SOURCE_NAME=King Bariki
AZAMPAY_SOURCE_BANK=Azampesa

# --- Firebase Admin SDK (server-side only, used by payment actions + webhook) ---
# Firebase Console > Project Settings > Service Accounts > Generate new private key.
# Paste the full JSON as a single-line string.
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'
